diff --git a/warp/native/deterministic_metal.h b/warp/native/deterministic_metal.h
new file mode 100644
index 00000000..692f52b0
--- /dev/null
+++ b/warp/native/deterministic_metal.h
@@ -0,0 +1,179 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+// Deterministic scatter support for the Metal backend.
+//
+// Metal float atomics are non-associative: the order in which threads perform
+// atomic_fetch_add varies run-to-run, so scattered float sums are not reproducible.
+// In deterministic mode (RUN_TO_RUN / GPU_TO_GPU) supported accumulation atomics are
+// redirected here: each thread records a (key, value) pair, where the key packs the
+// destination flat index in the upper 32 bits and the deterministic thread id in the
+// lower 32 bits. After the kernel, the host sorts the records by key (Warp's host radix
+// sort, since Metal arrays live in unified memory) and reduces them in that fixed order.
+//
+// Only the scatter/reduce path (return value unused) is implemented for Metal. The
+// consumed-return counter two-pass path and store guarding remain CUDA-only; kernels
+// that need them are refused on Metal in deterministic mode.
+//
+// This header is included only for Metal (see codegen). It mirrors the layout of the
+// CUDA det_scatter_buf_t / det_ctx in deterministic.h so the shared codegen parameter
+// packing (det_scatter_buf_t ctypes struct) matches.
+
+#if defined(__METAL_VERSION__)
+
+#include <metal_stdlib>
+
+namespace wp {
+
+// Layout must match warp._src.context.det_scatter_buf_t (keys, vals, count, capacity).
+template <typename T> struct det_scatter_buf_t {
+    int64_t* keys;
+    T* vals;
+    int* count;
+    int capacity;
+};
+
+// Layout must match warp._src.context.det_counter_buf_t (unused on Metal: nullptr).
+struct det_counter_buf_t {
+    int64_t* keys;
+    int* values;
+    int* prefixes;
+    int* record_slots;
+    int* cursors;
+    int* count;
+    int capacity;
+    int records_per_thread;
+    array_t<int> target;
+    int target_size;
+};
+
+// Layout must match the CUDA det_ctx (phase, debug, idx, overflow, counter_targets, count).
+struct det_ctx {
+    int phase;
+    int debug;
+    size_t idx;
+    int* overflow;
+    array_t<int>* counter_targets;
+    int counter_target_count;
+};
+
+namespace deterministic {
+
+// Record a (key, value) scatter. The counter slot is allocated with an integer atomic
+// (deterministic count, order-independent); the record order does not matter because the
+// host sorts by (dest_index, thread_id) before reducing.
+template <typename T>
+inline void scatter(det_ctx& ctx, det_scatter_buf_t<T>& buf, int dest_flat_idx, T value)
+{
+    int slot = wp_metal_atomic_add(buf.count, 1);
+    if (slot < buf.capacity) {
+        buf.keys[slot] = (static_cast<int64_t>(dest_flat_idx) << 32)
+            | static_cast<int64_t>(static_cast<unsigned int>(ctx.idx & 0xFFFFFFFFu));
+        buf.vals[slot] = value;
+    } else if (ctx.overflow != nullptr) {
+        int prev = wp_metal_atomic_cas(ctx.overflow, 0, 1);
+        if (ctx.debug && prev == 0) {
+            // Metal shader logging has no printf %s; keep a simple marker.
+            os_log("Warp deterministic scatter overflow");
+        }
+    }
+}
+
+// Metal does not implement the consumed-return counter path; these are never called
+// because such kernels are refused on Metal in deterministic mode. Provide stubs so
+// any referenced symbol compiles.
+inline int counter_add(det_ctx& ctx, det_counter_buf_t& buf, int dest_flat_idx, int value)
+{
+    (void)ctx;
+    (void)buf;
+    (void)dest_flat_idx;
+    (void)value;
+    return 0;
+}
+
+inline bool is_global_store_target(const void* ptr)
+{
+    (void)ptr;
+    return true;
+}
+
+inline bool is_counter_store_target(det_ctx& ctx, const void* ptr)
+{
+    (void)ctx;
+    (void)ptr;
+    return false;
+}
+
+template <template <typename> class A, typename T>
+inline void array_store_if_active(det_ctx& ctx, const A<T>& buf, int i, T value)
+{
+    (void)ctx;
+    wp::array_store(buf, i, value);
+}
+
+template <template <typename> class A, typename T>
+inline void array_store_if_active(det_ctx& ctx, const A<T>& buf, int i, int j, T value)
+{
+    (void)ctx;
+    wp::array_store(buf, i, j, value);
+}
+
+template <template <typename> class A, typename T>
+inline void array_store_if_active(det_ctx& ctx, const A<T>& buf, int i, int j, int k, T value)
+{
+    (void)ctx;
+    wp::array_store(buf, i, j, k, value);
+}
+
+template <template <typename> class A, typename T>
+inline void array_store_if_active(det_ctx& ctx, const A<T>& buf, int i, int j, int k, int l, T value)
+{
+    (void)ctx;
+    wp::array_store(buf, i, j, k, l, value);
+}
+
+}  // namespace deterministic
+}  // namespace wp
+
+// Active deterministic macros for Metal (mirror the __CUDA_ARCH__ block in deterministic.h).
+#define WP_DET_SCATTER_OR_FALLBACK(det_ctx, helper, flat_idx, value, cpu_expr) \
+    do { \
+        if ((det_ctx).phase != 0 && (helper).count != nullptr) { \
+            wp::deterministic::scatter((det_ctx), (helper), static_cast<int>(flat_idx), (value)); \
+        } else { \
+            cpu_expr; \
+        } \
+    } while (0)
+
+#define WP_DET_COUNTER_OR_FALLBACK(out, det_ctx, helper, flat_idx, value, cpu_expr) \
+    do { \
+        (void)(det_ctx); \
+        (void)(helper); \
+        (void)(flat_idx); \
+        (void)(value); \
+        (out) = 0; \
+        cpu_expr; \
+    } while (0)
+
+#define WP_DET_STORE_IF_ACTIVE(det_ctx, ...) \
+    do { \
+        (void)(det_ctx); \
+        wp::array_store(__VA_ARGS__); \
+    } while (0)
+
+#define WP_DET_SLOT_STORE_IF_ACTIVE(det_ctx, slot_lvalue, value_expr) \
+    do { \
+        (void)(det_ctx); \
+        (slot_lvalue) = (value_expr); \
+    } while (0)
+
+#define WP_DET_SIDE_EFFECT_IF_ACTIVE(det_ctx, ...) \
+    do { \
+        if ((det_ctx).phase != 0) { \
+            __VA_ARGS__ \
+        } \
+    } while (0)
+
+#endif  // __METAL_VERSION__
